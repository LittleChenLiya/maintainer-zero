{
  "schema_version": 1,
  "demos": [
    {
      "id": "maintainer-handoff",
      "scenario": "maintainer-zero",
      "before": {"path": "demo-before", "name": "demo", "commits": 100, "contributors": {"A": 85, "B": 15}, "dependencies": ["requests"], "workflows": ["ci.yml"], "codeowners": {}, "release_files": []},
      "after": {"path": "demo-after", "name": "demo", "commits": 100, "contributors": {"A": 45, "B": 35, "C": 20}, "dependencies": ["requests"], "workflows": ["ci.yml"], "codeowners": {"*": ["@b", "@c"]}, "release_files": ["release.yml"]},
      "lesson": "A documented backup owner and release handoff reduce the maintainer single point."
    },
    {
      "id": "dependency-cold-build",
      "scenario": "dependency-yanked",
      "before": {"path": "demo-before", "name": "demo", "commits": 30, "contributors": {"A": 20, "B": 10}, "dependencies": ["a", "b", "c", "d", "e"], "workflows": ["ci.yml"], "codeowners": {}, "release_files": []},
      "after": {"path": "demo-after", "name": "demo", "commits": 30, "contributors": {"A": 20, "B": 10}, "dependencies": ["a", "b"], "workflows": ["ci.yml"], "codeowners": {}, "release_files": []},
      "lesson": "A smaller, reviewed dependency surface makes the cold-build drill less exposed."
    },
    {
      "id": "ci-release-fallback",
      "scenario": "ci-outage",
      "before": {"path": "demo-before", "name": "demo", "commits": 30, "contributors": {"A": 20, "B": 10}, "dependencies": [], "workflows": ["ci.yml", "release.yml", "docs.yml"], "codeowners": {}, "release_files": ["release.yml"]},
      "after": {"path": "demo-after", "name": "demo", "commits": 30, "contributors": {"A": 20, "B": 10}, "dependencies": [], "workflows": ["ci.yml"], "codeowners": {}, "release_files": []},
      "lesson": "A documented local validation path avoids coupling the drill to an unavailable release workflow."
    }
  ]
}
